PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRATION=3600

DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=your_password
DB_ROOT_PASSWORD=your_root_password
DB_NAME=red_an_be_db

MAIL_STRATEGY=resend

RESEND_API_KEY=resend_api_key_here

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

SMTP_FROM=De-ID Studio <onboarding@resend.dev>
SALES_EMAIL=sales@yourdomain.com
FRONTEND_DOMAIN=https://app.deid.studio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002

# External NLP/ML recognizer feature flags.
# Set to 'true' only after the matching remote recognizer is deployed and
# registered inside the Presidio Analyzer instance.
#
# Enables FREE_TEXT and HEALTH_DATA detection (clinical NLP model required).
DE_ID_CLINICAL_NLP_ENABLED=false
#
# Enables GDPR special-category detection: RACE, RELIGION, POLITICAL_VIEWS,
# SEXUAL_LIFE, SEXUAL_ORIENTATION (ML context classifier required).
DE_ID_SENSITIVE_CATEGORIES_ENABLED=false

# Remote NLP recognizer service integration
DE_ID_REMOTE_NLP_URL=http://localhost:5003
DE_ID_REMOTE_NLP_TIMEOUT_MS=3000
DE_ID_REMOTE_NLP_RETRIES=1
DE_ID_REMOTE_NLP_STRICT_MODE=false

# Post-anonymization PHI validation
DE_ID_PHI_VALIDATION_STRICT=true
DE_ID_PHI_VALIDATION_ALLOW_ZIP3=true

DE_ID_SYNTHETIC_MAX_VARIANTS=20

# Remote NLP container model options
REMOTE_NLP_MODEL=facebook/bart-large-mnli
REMOTE_NLP_DEVICE=-1
REMOTE_NLP_DEFAULT_THRESHOLD=0.9
REMOTE_NLP_MAX_SENTENCE_LENGTH=700

# Stripe API keys (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Price ID for PROFESSIONAL plan
STRIPE_PRO_PRICE_ID=price_2hgfdhgfdHGFHGHFJytdbn

# Webhook signing secret. For local dev, use the value printed by:
#   stripe listen --forward-to localhost:3000/webhooks/stripe
# For production, copy from Dashboard → Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here